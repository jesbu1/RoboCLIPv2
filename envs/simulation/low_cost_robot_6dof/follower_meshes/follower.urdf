<?xml version="1.0"?>
<robot name="follower">

  <!-- Materials -->
  <material name="black" rgba="0.1 0.1 0.1 1"/>
  <material name="white" rgba="0.8 0.8 0.8 1"/>

  <!-- Links -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="base_link.STL"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="base_link_collision.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="link_1">
    <visual>
      <geometry>
        <mesh filename="link_1.STL"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="link_1_collision.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="link_2">
    <visual>
      <geometry>
        <mesh filename="link_2.STL"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="link_2_collision.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="link_3">
    <visual>
      <geometry>
        <mesh filename="link_3.STL"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="link_3_collision.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="link_4">
    <visual>
      <geometry>
        <mesh filename="link_4.STL"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="link_4_collision.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="link_5">
    <visual>
      <geometry>
        <mesh filename="link_5.STL"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="link_5_collision.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="link_6">
    <visual>
      <geometry>
        <mesh filename="link_6.STL"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="link_6_collision.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- End Effector Site -->
  <link name="end_effector_site">
    <visual>
      <geometry>
        <sphere radius="0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <!-- Joints -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="250" velocity="10"/>
    <origin xyz="0.012 0 0.0409" rpy="0 0 0"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="150" velocity="10"/>
    <origin xyz="0 -0.0209 0.0154" rpy="0 0 0"/>
  </joint>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-3.14" upper="3.14" effort="150" velocity="10"/>
    <origin xyz="-0.0148 0.0065 0.1083" rpy="0 0 0"/>
  </joint>

  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-3.14" upper="3.14" effort="150" velocity="10"/>
    <origin xyz="-0.10048 5e-05 0.0026999" rpy="0 0 0"/>
  </joint>

  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1"/>
    <origin xyz="-0.045 0.013097 0" rpy="0 0 0"/>
  </joint>

  <joint name="joint_6" type="revolute">
    <parent link="link_5"/>
    <child link="link_6"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.45" upper="0.032" effort="2" velocity="1"/>
    <origin xyz="-0.01315 -0.0075 0.0145" rpy="0 0 0"/>
  </joint>

  <!-- Actuators -->
  <actuator>
    <position joint="joint_1" pid="100 10 0"/>
    <position joint="joint_2" pid="100 10 0"/>
    <position joint="joint_3" pid="100 10 0"/>
    <position joint="joint_4" pid="100 10 0"/>
    <position joint="joint_5" pid="10 1 0"/>
    <position joint="joint_6" pid="10 1 0"/>
  </actuator>

  <!-- Attach End Effector Site -->
  <joint name="end_effector_joint" type="fixed">
    <parent link="link_5"/>
    <child link="end_effector_site"/>
    <origin xyz="-0.06429 0.00327 0.0011" rpy="0 0 0"/>
  </joint>

</robot>
